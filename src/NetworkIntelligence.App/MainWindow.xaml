<Window x:Class="NetworkIntelligence.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
 Title="Network Intelligence">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
   <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Grid.Resources>
  <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="246" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="NavigationChanged" Loaded="WindowLoaded">
   <NavigationView.PaneHeader><StackPanel Margin="14,18,0,22" Spacing="4"><TextBlock Text="NETWORK" FontSize="17" FontWeight="Bold" CharacterSpacing="170"/><TextBlock Text="INTELLIGENCE" FontSize="11" CharacterSpacing="210" Opacity="0.65"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="Overview" Tag="Dashboard"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Ethernet" Tag="Ethernet"><NavigationViewItem.Icon><FontIcon Glyph="&#xE839;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Wi-Fi" Tag="Wifi"><NavigationViewItem.Icon><FontIcon Glyph="&#xE701;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Network performance" Tag="Performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Bandwidth and data" Tag="Usage"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Application usage" Tag="Applications"><NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Connection history" Tag="History"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="Diagnostics" Tag="Diagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter><StackPanel Margin="16,12" Spacing="8"><TextBlock Text="ON THIS DEVICE" Style="{StaticResource Caption}"/><TextBlock Text="Private by design" FontSize="13"/><TextBlock Text="Early access · 0.2" Style="{StaticResource Caption}"/></StackPanel></NavigationView.PaneFooter>
   <Grid Padding="28,12,28,16" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Text="Network overview" Style="{StaticResource Heading}"/><TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Caption}"/></StackPanel>
     <Button Grid.Column="1" x:Name="PauseButton" Content="Pause monitoring" Click="PauseClicked" VerticalAlignment="Center"/>
     <Button Grid.Column="2" Content="Export" Click="ExportClicked" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid>
      <StackPanel x:Name="DashboardPage" Spacing="18">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="YOUR CONNECTION" Style="{StaticResource Caption}"/><TextBlock Text="{Binding AdapterName}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding AdapterDescription}" Style="{StaticResource Caption}"/></StackPanel>
        <ComboBox Grid.Column="1" x:Name="AdapterPicker" Header="Adapter" Width="250" ItemsSource="{Binding Adapters}" DisplayMemberPath="Name" SelectionChanged="AdapterChanged" />
       </Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="↓  DOWNLOAD" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Download}" FontSize="34" FontWeight="SemiBold" Foreground="#18BDAA"/><TextBlock Text="Measured adapter throughput" Style="{StaticResource Caption}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="↑  UPLOAD" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Upload}" FontSize="34" FontWeight="SemiBold" Foreground="#6996F0"/><TextBlock Text="Measured adapter throughput" Style="{StaticResource Caption}"/></StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Center" MinWidth="120"><TextBlock Text="NETWORK HEALTH" Style="{StaticResource Caption}"/><TextBlock Text="{Binding HealthScoreText}" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="{Binding HealthBandText}" Style="{StaticResource Caption}"/></StackPanel>
        <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Health.Detail}" Style="{StaticResource Caption}"/>
         <ItemsControl ItemsSource="{Binding Health.Factors}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </Grid></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
        <Grid><TextBlock Text="Live traffic" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="↓ Download    ↑ Upload · last 90 samples" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
        <lvc:CartesianChart Height="240" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" AnimationsSpeed="0:0:0" />
        <TextBlock Text="{Binding MeasurementDetail}" Style="{StaticResource Caption}"/>
       </StackPanel></Border>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="LINK STATUS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Connection}" FontSize="22"/><TextBlock Text="{Binding Gateway}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Internet}" Style="{StaticResource Caption}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="THIS MONITORING SESSION" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SessionUsage}" FontSize="20" TextWrapping="Wrap"/><TextBlock Text="Measured intervals only · selected adapter" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CounterDetail}" Style="{StaticResource Caption}"/></StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="10">
        <TextBlock Text="Recent alerts" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Unusual application bandwidth vs. learned baseline · bandwidth only, never a malware or security determination · see Application usage to mark an app trusted." Style="{StaticResource Caption}"/>
        <ItemsControl ItemsSource="{Binding RecentAlerts}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><Button Content="Snooze 1h" Click="SnoozeAlert" HorizontalAlignment="Stretch"/><Button Content="Dismiss" Click="DismissAlert" HorizontalAlignment="Stretch"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
       <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Application intelligence is under validation" Message="Process connection ownership and live/stored per-app bandwidth are available (optional MonitoringService). Anomaly detection and the network health score above are both algorithmic and unvalidated at scale — see each card's contributing factors for what's actually measured."/>
      </StackPanel>
      <StackPanel x:Name="EthernetPage" Spacing="16" Visibility="Collapsed"><TextBlock Text="All Ethernet interfaces, including virtual interfaces. Link capacity and current throughput are different measurements." TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{Binding Ethernet}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Text="{Binding Title}" FontSize="20"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel x:Name="WifiPage" Spacing="16" Visibility="Collapsed"><TextBlock Text="Native WLAN details refresh every 10 seconds. SSID collection is off by default. Signal quality is reported by the driver." TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{Binding Wifi}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel Spacing="8"><TextBlock Text="{Binding Title}" FontSize="20"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel x:Name="PerformancePage" Spacing="16" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Target performance" FontSize="20"/><TextBlock Text="{Binding DiagnosticText}" TextWrapping="Wrap"/><Button Content="Open diagnostics" Click="OpenDiagnostics"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Internet transfer test" FontSize="20"/><TextBlock Text="A manual HTTPS transfer test uses up to 25 MB download and 10 MB upload. The endpoint receives your public IP. Results measure this transfer, not your link capacity or a certified maximum speed." TextWrapping="Wrap"/><TextBox x:Name="SpeedEndpoint" Header="Provider base URL (Cloudflare-compatible)" Text="https://speed.cloudflare.com" MaxWidth="600" HorizontalAlignment="Left"/><Button x:Name="SpeedButton" Content="Run transfer test…" Click="SpeedClicked"/><TextBlock x:Name="SpeedResult" Text="Not run. Automatic testing is disabled." TextWrapping="Wrap"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="UsagePage" Spacing="16" Visibility="Collapsed"><TextBlock Text="Historical traffic · measured intervals only" FontSize="20"/><ComboBox x:Name="HistoryRange" Header="Time range" SelectedIndex="1" SelectionChanged="HistoryRangeChanged"><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="Last 365 days"/></ComboBox><Button Content="Refresh history" Click="RefreshHistory"/><TextBlock Text="Physical and virtual adapters may count the same traffic. Compare adapters individually; totals are not added together. Minute buckets are assigned by interval end time." TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Usage}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <StackPanel x:Name="ApplicationsPage" Spacing="16" Visibility="Collapsed">
       <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Live bandwidth requires the optional monitoring service" Message="Off by default. Install and run NetworkIntelligence.MonitoringService (see README) to see live per-app download/upload bytes below. Its accuracy has only been validated for a single loopback connection — treat totals as indicative, not yet certified for general use."/>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="10">
        <TextBlock Text="Live per-application bandwidth (optional)" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ApplicationTrafficStatus}" Style="{StaticResource Caption}"/>
        <ItemsControl ItemsSource="{Binding LiveApplicationTraffic}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/></StackPanel><Button Grid.Column="1" Content="Trust this app" VerticalAlignment="Top" Click="TrustApplication"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="10">
        <TextBlock Text="Stored per-application history (optional)" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Same time range as Bandwidth and data · minute buckets grouped by process ID and name, not a stable app identity · refresh from Bandwidth and data or on next launch." Style="{StaticResource Caption}"/>
        <ItemsControl ItemsSource="{Binding AppUsage}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
       <TextBox x:Name="ApplicationSearch" PlaceholderText="Search application or PID" TextChanged="SearchChanged"/>
       <TextBlock Text="Sorted by socket count · IPv4/IPv6 TCP and UDP · live metadata only; no history stored for this list." Style="{StaticResource Caption}"/>
       <ItemsControl ItemsSource="{Binding Applications}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel x:Name="HistoryPage" Spacing="16" Visibility="Collapsed"><TextBlock Text="Observed adapter transitions · latest 200 events" FontSize="20"/><TextBlock Text="Events are recorded while this app is monitoring. The initial state is not counted as a disconnect." TextWrapping="Wrap"/><Button Content="Refresh events" Click="RefreshHistory"/><ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <StackPanel x:Name="DiagnosticsPage" Spacing="16" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Check a network target" FontSize="20"/><TextBlock Text="Runs DNS resolution and 10 ICMP probes. Failed ping alone does not prove an internet outage. Your chosen target receives diagnostic traffic." TextWrapping="Wrap"/><TextBox x:Name="DiagnosticTarget" Header="Hostname or IP address" Text="1.1.1.1" MaxWidth="500" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="DiagnosticButton" Content="Run diagnostics" Click="DiagnosticsClicked"/><Button Content="Cancel test" Click="CancelDiagnostics"/></StackPanel><ProgressRing x:Name="DiagnosticProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock Text="{Binding DiagnosticText}" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="Selected adapter configuration" FontSize="20"/><TextBlock Text="{Binding AddressDetail}" TextWrapping="Wrap"/><TextBlock Text="{Binding Gateway}" TextWrapping="Wrap"/><Button Content="Check database integrity" Click="IntegrityClicked"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="SettingsPage" Spacing="18" Visibility="Collapsed">
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Monitoring and appearance" FontSize="20"/><NumberBox x:Name="Retention" Header="History retention (days)" Minimum="1" Maximum="3650" Value="365" SpinButtonPlacementMode="Inline" Width="230" HorizontalAlignment="Left"/><ComboBox x:Name="ThemePicker" Header="Theme" SelectedIndex="0"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><ToggleSwitch x:Name="CloseToTray" Header="Keep monitoring when the window closes" IsOn="True"/><TextBlock Text="When enabled, use the tray icon to reopen the window or Exit to stop monitoring. The app does not start automatically with Windows." TextWrapping="Wrap" Style="{StaticResource Caption}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Privacy" FontSize="20"/><ToggleSwitch x:Name="CollectAddresses" Header="Show local IP, gateway and DNS addresses"/><ToggleSwitch x:Name="CollectSsid" Header="Show Wi-Fi network name (SSID)"/><ToggleSwitch x:Name="CollectNames" Header="Show process names" IsOn="True"/><TextBlock Text="These details stay in live memory. Addresses, SSIDs, executable paths, remote destinations and application histories are not stored. Packet payloads are never collected." TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Connection notifications" FontSize="20"/><ToggleSwitch x:Name="AlertsEnabled" Header="Notify about adapter disconnections" IsOn="True"/><ToggleSwitch x:Name="QuietEnabled" Header="Quiet hours"/><StackPanel Orientation="Horizontal" Spacing="12"><NumberBox x:Name="QuietStart" Header="Start hour" Minimum="0" Maximum="23" Value="22" Width="140"/><NumberBox x:Name="QuietEnd" Header="End hour" Minimum="0" Maximum="23" Value="7" Width="140"/></StackPanel><TextBlock Text="Local time · also gates anomaly notifications below · native tray notifications" Style="{StaticResource Caption}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
        <TextBlock Text="Application anomaly detection (optional)" FontSize="20"/>
        <TextBlock Text="Requires the optional MonitoringService (Application usage page) and at least 7 days / 60 samples of learned history per application before it can alert — new applications are never flagged. Bandwidth deviation only; never a malware or security determination." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
        <ToggleSwitch x:Name="AnomalyEnabled" Header="Detect unusual application bandwidth" IsOn="True"/>
        <NumberBox x:Name="AnomalySensitivity" Header="Sensitivity (standard deviations; lower is more sensitive)" Minimum="1.5" Maximum="6.0" SmallChange="0.5" Value="3.0" SpinButtonPlacementMode="Inline" Width="280" HorizontalAlignment="Left"/>
        <TextBlock Text="Trusted applications (excluded from detection):" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="NoTrustedApplicationsText" Text="None yet — use &quot;Trust this app&quot; on the Application usage page." TextWrapping="Wrap"/>
        <ItemsControl x:Name="TrustedApplicationsList"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="12" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Untrust" Click="UntrustApplication"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
       <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Save settings" Click="SaveSettings"/><Button Content="Delete stored history…" Click="DeleteHistory"/></StackPanel><TextBlock x:Name="StoragePath" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
