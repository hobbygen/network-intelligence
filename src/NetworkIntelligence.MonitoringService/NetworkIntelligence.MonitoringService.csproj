<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <Version>0.1.0</Version>
    <Description>Optional, explicitly-installed elevated collector for per-application network telemetry. Never runs by default; never reads packet payloads.</Description>
    <UserSecretsId>dotnet-NetworkIntelligence.MonitoringService</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetworkIntelligence.Contracts/NetworkIntelligence.Contracts.csproj" />
  </ItemGroup>

</Project>
